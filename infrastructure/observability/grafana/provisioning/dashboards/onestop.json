{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 39,
  "title": "OneStop Overview",
  "uid": "onestop-overview",
  "panels": [
    {
      "type": "stat",
      "title": "Services up",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "datasource": { "type": "prometheus" }, "expr": "count(up{job=\"onestop-services\"} == 1)", "legendFormat": "up" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate (req/s) by service",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 9, "w": 18, "x": 6, "y": 0 },
      "targets": [
        { "datasource": { "type": "prometheus" }, "expr": "sum by (service) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used by service",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "datasource": { "type": "prometheus" }, "expr": "sum by (service) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{service}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 request latency (s) by service",
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "datasource": { "type": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{service}}" }
      ]
    }
  ]
}
