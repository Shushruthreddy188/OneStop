# Copy to .env.production on the server and replace every value.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_TOKEN=replace-with-a-different-long-random-value
PUBLIC_ORIGIN=http://replace-with-your-public-ip-or-domain
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
BACKUP_S3_BUCKET=replace-with-private-backup-bucket-name
